# Copy to .env. Settings that start with WARMER_ go to the worker; see warmer/README.md for all of them.

# The address clients use for Remux.
REMUX_HOSTNAME=remux.example.com
# The folder holding Remux's db.sqlite.
REMUX_DATA_DIR=/srv/remux
# Where the cache, and the worker's state, are kept. The cache can use up to 60 GB (see nginx/nginx.conf).
DATA_DIR=./data
# The Docker network Remux and Traefik share, and the name of Traefik's certificate resolver.
REMUX_NETWORK=remux
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional. The first fill is large with all of these on: see "What it warms" in warmer/README.md.
# WARMER_PEOPLE=on
# WARMER_EPISODES=on
# WARMER_CHANNELS=on
# WARMER_GUIDE=on
